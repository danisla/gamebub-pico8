+int foreach_c(lua_State *L) {
+    if (!lua_isfunction(L, 2)) return callLuaVersion(L);
+    lua_settop(L, 2);
+    lua_pushcfunction(L, all);
+    lua_pushvalue(L, 1);
+    lua_call(L, 1, 1);  // the iterator (3)
+    for (;;) {
+        lua_pushvalue(L, 3);
+        lua_call(L, 0, 1);
+        if (lua_isnil(L, -1)) break;
+        lua_pushvalue(L, 2);
+        lua_insert(L, -2);
+        lua_call(L, 1, 0);
+    }
+    return 0;
