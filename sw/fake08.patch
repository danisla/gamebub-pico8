+        return 1;
+    }
+    lua_len(L, 1);
+    lua_pushnumber(L, fix32(0));
+    const bool empty = lua_compare(L, -2, -1, LUA_OPEQ);
+    lua_pop(L, 2);
+    if (empty) {
+        lua_pushcfunction(L, all_empty);
+        return 1;
+    }
+    lua_settop(L, 1);
+    lua_pushnumber(L, fix32(1));
+    lua_pushnil(L);
+    lua_pushcclosure(L, all_iter, 3);
+    return 1;
