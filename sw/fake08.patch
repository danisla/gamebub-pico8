+
+// A table without a metatable (raw accesses are what c[i] and #c do), and
+// short enough for fix32 indices.
+bool plainTable(lua_State *L, int idx, int *n) {
+    if (lua_type(L, idx) != LUA_TTABLE) return false;
+    if (lua_getmetatable(L, idx)) {
+        lua_pop(L, 1);
+        return false;
+    }
+    size_t len = lua_rawlen(L, idx);
+    if (len >= 32767) return false;
+    *n = (int)len;
+    return true;
+}
+
+// PICO-8 mid(x, y, z) (lpico8lib.c).
+fix32 mid3(fix32 x, fix32 y, fix32 z) {
+    return x > y ? y > z ? y : fix32::min(x, z) : x > z ? x : fix32::min(y, z);
+}
+
+// The index argument of add/deli: absent (nil or false) or a number.
+bool indexArg(lua_State *L, int idx, bool *given, fix32 *i) {
+    const int t = lua_type(L, idx);
+    if (t <= LUA_TNIL || (t == LUA_TBOOLEAN && !lua_toboolean(L, idx))) {
+        *given = false;
+        return true;
+    }
+    if (t != LUA_TNUMBER) return false;
+    *given = true;
+    *i = fix32::floor(lua_tonumberx(L, idx, NULL));  // i\1
+    return true;
