+
+//   i=i and mid(1,i\1,#c+1) or #c+1
+//   for j=#c,i,-1 do c[j+1]=c[j] end
+//   c[i]=x
+//   return x
+int add_c(lua_State *L) {
+    int n;
+    bool given;
+    fix32 i;
+    if (!plainTable(L, 1, &n) || !indexArg(L, 3, &given, &i)) return callLuaVersion(L);
+    lua_settop(L, 2);
+    const int at = (int)(given ? mid3(fix32(1), i, fix32(n + 1)) : fix32(n + 1));
