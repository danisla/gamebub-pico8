+
+// count, foreach, add, del, deli: fake-08 has them in Lua
+// (p8GlobalLuaFunctions.h), which costs up to ~8% of a cart's Lua time
+// (count, foreach in Celeste; deli in Dinky Kong). installTableHelpers()
+// replaces each with a C function for the common case (a table without a
+// metatable, the usual argument types), with the same results as the Lua
+// version; any other case calls the Lua version (upvalue 1), for its exact
+// behavior and error messages.
+namespace {
+
+int callLuaVersion(lua_State *L) {
+    const int n = lua_gettop(L);
+    lua_pushvalue(L, lua_upvalueindex(1));
+    lua_insert(L, 1);
+    lua_call(L, n, LUA_MULTRET);
+    return lua_gettop(L);
