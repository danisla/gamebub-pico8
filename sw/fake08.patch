+namespace {
+// Map geometry (from the map memory mapping and width registers). Computing it
+// needs a division, so it's cached: mget is called for every cell by map().
+struct MapGeometry {
+	uint8_t mapping;
+	uint8_t width;
+	bool bigMap;
+	int mapW;
+	int mapH;
+	int offset; // big map: offset in userData
+};
+MapGeometry mapGeometry = {0xff, 0xff, false, 0, 0, 0};
+
+inline const MapGeometry &getMapGeometry(PicoRam *memory) {
+	uint8_t mapping = memory->hwState.mapMemMapping;
+	uint8_t width = memory->hwState.widthOfTheMap;
+	if (mapping != mapGeometry.mapping || width != mapGeometry.width) {
+		const bool bigMap = mapping >= 0x80;
+		const int bigMapLocation = mapping << 8;
+		const int mapSize = bigMap ? 0x10000 - bigMapLocation : 8192;
+		const int mapW = width == 0 ? 256 : width;
+		mapGeometry.mapping = mapping;
+		mapGeometry.width = width;
+		mapGeometry.bigMap = bigMap;
+		mapGeometry.mapW = mapW;
+		mapGeometry.mapH = mapSize / mapW;
+		mapGeometry.offset = 0x8000 - mapSize;
+	}
+	return mapGeometry;
+}
