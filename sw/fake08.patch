+// lua_tonumber() returns a fix32, which the functions below mostly assign to
+// int variables: implicitly, that goes through operator double (soft float on
+// the Game Bub: fix32 -> double -> int, ~4% of a busy cart's time). The
+// argument converts to integer types directly instead, with the same result
+// as through double: truncated toward zero, and a negative number to a 32-bit
+// unsigned type is 0 (as RISC-V's soft float conversion; casts with
+// (int) use fix32's own conversion, which floors: those call lua_tonumberx).
+namespace {
+struct LuaNumberArg {
+    fix32 v;
+    operator fix32() const { return v; }
+    operator double() const { return (double)v; }
+    template <typename T, typename std::enable_if<std::is_integral<T>::value, int>::type = 0>
+    operator T() const {
+        const int32_t bits = v.bits();
+        int32_t t = bits >> 16;
+        if (bits < 0 && (bits & 0xffff)) t++;
+        if (std::is_same<T, bool>::value) return bits != 0;
+        if (std::is_unsigned<T>::value && sizeof(T) >= sizeof(int32_t) && t < 0) return T(0);
+        return T(t);
+    }
+};
+}
+#undef lua_tonumber
+#define lua_tonumber(L, i) (LuaNumberArg{lua_tonumberx(L, i, NULL)})
