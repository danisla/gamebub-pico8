--- a/libs/z8lua/fix32.h	2026-09-27 14:58:35.525267546 -0700
+++ b/libs/z8lua/fix32.h	2026-09-27 14:58:35.533047254 -0700
@@ -25,6 +25,43 @@
     inline fix32() = default;
 
     // Convert from/to double
+#if defined(__GAMEBUB__)
+    // No FPU: convert with integer operations (the implicit conversion to
+    // double is used for every number argument of the PICO-8 API functions).
+    inline fix32(double d)
+      : m_bits(from_double_bits(d))
+    {}
+
+    inline operator double() const
+    {
+        int32_t v = m_bits;
+        if (v == 0) return 0.0;
+        uint64_t sign = v < 0 ? 1 : 0;
+        uint32_t a = v < 0 ? uint32_t(0) - uint32_t(v) : uint32_t(v);
+        int e = 31 - __builtin_clz(a);
+        uint64_t mantissa = (uint64_t(a) << (52 - e)) & ((uint64_t(1) << 52) - 1);
+        uint64_t bits = (sign << 63) | (uint64_t(e - 16 + 1023) << 52) | mantissa;
+        double d;
+        __builtin_memcpy(&d, &bits, sizeof(d));
+        return d;
+    }
+
+    // int32_t(int64_t(d * 65536.0)), without floating point operations.
+    static inline int32_t from_double_bits(double d)
+    {
+        uint64_t bits;
+        __builtin_memcpy(&bits, &d, sizeof(bits));
+        int e = int((bits >> 52) & 0x7ff) - 1023;
+        if (e < -17 || e >= 1024) return 0;
+        uint64_t m = (bits & ((uint64_t(1) << 52) - 1)) | (uint64_t(1) << 52);
+        int shift = e + 16 - 52;
+        uint64_t r;
+        if (shift >= 0) r = shift >= 64 ? 0 : m << shift;
+        else r = -shift >= 64 ? 0 : m >> -shift;
+        if (bits >> 63) r = uint64_t(0) - r;
+        return int32_t(uint32_t(r));
+    }
+#else
     inline fix32(double d)
       : m_bits(int32_t(int64_t(d * 65536.0)))
     {}
@@ -33,6 +70,7 @@
     {
         return double(m_bits) * (1.0 / 65536.0);
     }
+#endif
 
     // Conversions up to int16_t are safe.
     inline fix32(int8_t x)  : m_bits(int32_t(x << 16)) {}
