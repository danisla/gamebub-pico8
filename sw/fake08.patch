+        lua_rawseti(L, 1, j + 1);
+    }
+    lua_pushvalue(L, 2);
+    lua_rawseti(L, 1, at);
+    return 1;  // x
+}
+
+//   local max = #c
+//   for i=1,max do
+//     if c[i]==v then
+//       for j=i,max do c[j]=c[j+1] end
+//       return v
+//     end
+//   end
+int del_c(lua_State *L) {
+    int n;
+    if (!plainTable(L, 1, &n)) return callLuaVersion(L);
+    lua_settop(L, 2);
+    for (int i = 1; i <= n; i++) {
+        lua_rawgeti(L, 1, i);
+        const bool found = lua_compare(L, -1, 2, LUA_OPEQ);
+        lua_pop(L, 1);
+        if (found) {
+            for (int j = i; j <= n; j++) {
+                lua_rawgeti(L, 1, j + 1);
+                lua_rawseti(L, 1, j);
+            }
+            return 1;  // v
+        }
+    }
+    return 0;
+}
+
+//   i=i and mid(1,i\1,#c) or #c
+//   local v=c[i]
+//   for j=i,#c do c[j]=c[j+1] end
+//   return v
+int deli_c(lua_State *L) {
+    int n;
+    bool given;
+    fix32 i;
+    if (!plainTable(L, 1, &n) || !indexArg(L, 2, &given, &i)) return callLuaVersion(L);
+    lua_settop(L, 1);
+    const int at = (int)(given ? mid3(fix32(1), i, fix32(n)) : fix32(n));
+    lua_rawgeti(L, 1, at);  // v
+    for (int j = at; j <= n; j++) {
+        lua_rawgeti(L, 1, j + 1);
+        lua_rawseti(L, 1, j);
+    }
+    return 1;
+}
+
+}  // namespace
+
+void installTableHelpers(lua_State *L) {
+    const struct { const char *name; lua_CFunction f; } helpers[] = {
+        {"count", count_c}, {"foreach", foreach_c}, {"add", add_c}, {"del", del_c}, {"deli", deli_c},
+    };
+    for (auto &h : helpers) {
+        lua_getglobal(L, h.name);  // the Lua version
+        lua_pushcclosure(L, h.f, 1);
+        lua_setglobal(L, h.name);
+    }
+}
