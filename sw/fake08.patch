+// all(c): iterates over the non-nil values of c[1..#c], going on correctly
+// when the current value is deleted. The same as fake-08's Lua version
+// (p8GlobalLuaFunctions.h had it), in C as in PICO-8: the Lua iterator was
+// ~25% of the time of carts looping over their objects with all().
+//   if c==nil or #c==0 then return function() end
+//   local i,prev = 1,nil
+//   return function()
+//     if c[i]==prev then i+=1 end
+//     while i<=#c and c[i]==nil do i+=1 end
+//     prev=c[i]
+//     return prev
+//   end
+static int all_empty(lua_State *L) {
+    return 0;
+}
+
+static int all_iter(lua_State *L) {
+    const int c = lua_upvalueindex(1), iu = lua_upvalueindex(2), prevu = lua_upvalueindex(3);
+    fix32 i = lua_tonumberx(L, iu, NULL);
+    if (lua_type(L, c) == LUA_TTABLE && !lua_getmetatable(L, c)) {
+        // A plain table: raw accesses (what c[i] and #c are without a
+        // metatable).
+        lua_rawgeti(L, c, (int)i);
+        if (lua_compare(L, -1, prevu, LUA_OPEQ)) i = i + fix32(1);
+        lua_pop(L, 1);
+        const fix32 n = fix32((int)lua_rawlen(L, c));
+        for (;;) {
+            lua_rawgeti(L, c, (int)i);
+            if (!(i <= n) || !lua_isnil(L, -1)) break;
+            lua_pop(L, 1);
+            i = i + fix32(1);
+        }
+    } else {
+        // Any value: with metamethods (__index, __len, __eq, __le).
+        lua_pushnumber(L, i);
+        lua_gettable(L, c);
+        if (lua_compare(L, -1, prevu, LUA_OPEQ)) i = i + fix32(1);
+        lua_pop(L, 1);
+        for (;;) {
+            lua_pushnumber(L, i);
+            lua_len(L, c);
+            const bool in = lua_compare(L, -2, -1, LUA_OPLE);
+            lua_pop(L, 2);
+            lua_pushnumber(L, i);
+            lua_gettable(L, c);
+            if (!in || !lua_isnil(L, -1)) break;
+            lua_pop(L, 1);
+            i = i + fix32(1);
+        }
+    }
+    // c[i] (the new prev) is on the top.
+    lua_pushnumber(L, i);
+    lua_replace(L, iu);
+    lua_pushvalue(L, -1);
+    lua_replace(L, prevu);
+    return 1;
