+++ b/libs/z8lua/lobject.c	2026-10-01 10:20:02.428099721 -0700
@@ -210,6 +210,27 @@
 
 int luaO_str2d (const char *s, size_t len, lua_Number *result) {
   char *endptr;
+  {
+    /* Fast path for decimal integers ([spaces][sign]digits[spaces], up to 9
+       digits): the same result as strtod and the double to fix32 conversion
+       (int32(int64(v * 65536))), without floating point. */
+    const char *p = s, *e = s + len;
+    while (p < e && lisspace(cast_uchar(*p))) p++;
+    int neg = 0;
+    if (p < e && (*p == '-' || *p == '+')) { neg = (*p == '-'); p++; }
+    const char *digits = p;
+    long long v = 0;
+    while (p < e && *p >= '0' && *p <= '9' && p - digits < 9) { v = v * 10 + (*p - '0'); p++; }
+    if (p > digits && (p == e || !(*p >= '0' && *p <= '9'))) {
+      const char *q = p;
+      while (q < e && lisspace(cast_uchar(*q))) q++;
+      if (q == e) {
+        if (neg) v = -v;
+        *result = z8::fix32::frombits((int32_t)(uint32_t)(unsigned long long)(v << 16));
+        return 1;
+      }
+    }
+  }
   if (strpbrk(s, "nN"))  /* reject 'inf' and 'nan' */
     return 0;
   else if (strpbrk(s, "xX"))  /* hexa? */
